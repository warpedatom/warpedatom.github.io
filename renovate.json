{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["on monday and thursday"],
  "prCreation": "not-pending",
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "automerge": false
    },
    {
      "matchPackagePatterns": ["actions/checkout", "actions/upload-pages-artifact", "actions/deploy-pages", "actions/configure-pages"],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackagePatterns": ["jekyll"],
      "groupName": "Jekyll ecosystem"
    }
  ]
}
